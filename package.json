{
  "name": "@stellar-aid/api",
  "version": "0.1.0",
  "private": true,
  "description": "StellarAid backend: Fastify API, SEP-10 auth, and the chain indexer.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:indexer": "tsx watch src/indexer.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start:server": "node dist/server.js",
    "start:indexer": "node dist/indexer.js",
    "indexer:backfill": "tsx src/indexer/backfill.ts",
    "indexer:reset": "tsx src/indexer/reset.ts",
    "indexer:reconcile": "tsx src/indexer/reconcile.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir test/integration",
    "test:coverage": "vitest run --coverage",
    "openapi:export": "tsx scripts/openapi-export.ts",
    "loadtest": "tsx scripts/load-test.ts",
    "prisma": "prisma",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@prisma/client": "^6.1.0",
    "@sentry/node": "^11.10.0",
    "@stellar-aid/sdk": "file:../sdk",
    "@stellar/stellar-sdk": "13.3.0",
    "bullmq": "^6.5.3",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "9.0.2",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "^20.17.6",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.3.3",
    "prisma": "^6.1.0",
    "testcontainers": "^10.13.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
